APP_NAME=KoyunChat
APP_ENV=production
APP_URL=https://chat.koyun.edu.kg
ALLOWED_ORIGINS=https://chat.koyun.edu.kg,http://localhost,http://localhost:3000

POSTGRES_DB=koyunchat
POSTGRES_USER=koyunchat
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://koyunchat:change_me@postgres:5432/koyunchat

REDIS_URL=redis://redis:6379/0

JWT_SECRET=change_me_long_random_string
JWT_EXPIRE_MINUTES=10080

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

EASYPAY_PID=
EASYPAY_KEY=
EASYPAY_NOTIFY_URL=

NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_WIDGET_BASE_URL=
